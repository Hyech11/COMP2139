@model EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<h2>Edit Your Profile</h2>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">@TempData["Message"]</div>
}

<form asp-action="EditProfile" method="post">
    <div class="mb-3">
        <label asp-for="FullName"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ContactInfo"></label>
        <input asp-for="ContactInfo" class="form-control" />
        <span asp-validation-for="ContactInfo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PreferredCategory"></label>
        <input asp-for="PreferredCategory" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>