@model List<TaskItem>
@{
ViewBag.Title = "Tasks List";
var project = ViewBag.Project as Project;
}

<h2>Tasks List</h2>

@if (project == null)
{
<p>No project loaded.</p>
}
else
{
<p><strong>Project:</strong> @project.Name</p>
}

@if (Model == null || !Model.Any())
{
<p>No tasks available</p>
}
else
{
<table class="table">
    <thead>
    <tr>
        <th>Task ID</th>
        <th>Title</th>
        <th>Description</th>
        <th>Project ID</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var task in Model)
    {
    <tr>
        <td>@task.Id</td>
        <td>@task.Title</td>
        <td>@task.Description</td>
        <td>@task.ProjectId</td>
        <td>
            <a class="btn btn-info" asp-action="Details" asp-route-id="@task.Id">Details</a>
            <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@task.Id">Edit</a>
            <a class="btn btn-danger" asp-action="Delete" asp-route-id="@task.Id">Delete</a>
        </td>
    </tr>
    }
    </tbody>
</table>
}

<a class="btn btn-primary" asp-action="Create" asp-route-projectId="@ViewBag.ProjectId">Create New Task</a>
<a class="btn btn-secondary" asp-controller="Projects" asp-action="Index">Back to Projects</a>
