@model ProjectManagementApp.Models.ManageUserRolesViewModel

<h2>Manage Roles for @Model.Email</h2>

<form method="post">
    <input type="hidden" asp-for="UserId" />
    <table>
        <thead>
        <tr>
            <th>Role</th>
            <th>Assigned</th>
        </tr>
        </thead>
        <tbody>
        @for (var i = 0; i < Model.Roles.Count; i++)
        {
        <tr>
            <td>@Model.Roles[i].RoleName</td>
            <td>
                <input type="checkbox" asp-for="Roles[i].IsSelected" />
                <input type="hidden" asp-for="Roles[i].RoleName" />
            </td>
        </tr>
        }
        </tbody>
    </table>
    <button type="submit">Update Roles</button>
</form>
