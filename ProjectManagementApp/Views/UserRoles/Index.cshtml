@model List<ProjectManagementApp.Models.UserRolesViewModel>

<h2>User Roles</h2>

<table class="table">
    <thead>
    <tr>
        <th>Email</th>
        <th>Roles</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.Email</td>
            <td>
                @foreach (var role in user.Roles)
                {
                    <span class="badge bg-primary">@role</span>
                    <td> <a asp-action="Manage" asp-route-userId="@user.UserId">Manage Roles</a> </td>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
