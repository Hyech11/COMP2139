@model List<Project>

<h2>Project Listing</h2>

<a class="btn btn-primary mb-3" asp-action="Create">Create New Project</a>

<table class="table">
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Description</th>
        <th>Summary</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var project in Model)
    {
        <tr>
            <td>@project.ProjectId</td>
            <td>@project.Name</td>
            <td>@project.Description</td>
            <td>
                <strong>@project.Name</strong><br />
                @project.Description<br />
                <strong>Start Date:</strong> @project.StartDate.ToShortDateString()<br />
                <strong>End Date:</strong> @project.EndDate.ToShortDateString()<br />
                

                <strong>Tasks</strong>
                <ul>
                    @foreach (var task in project.Tasks)
                    {
                        <li>
                            <strong>@task.Title</strong><br />
                            @task.Description
                        </li>
                    }
                </ul>
            </td>
            <td>
                <a class="btn btn-info" asp-action="Details" asp-route-id="@project.ProjectId">Details</a>
                <a class="btn btn-secondary" asp-action="Edit" asp-route-id="@project.ProjectId">Edit</a>
                <a class="btn btn-danger" asp-action="Delete" asp-route-id="@project.ProjectId">Delete</a>
                <a class="btn btn-warning" asp-controller="Tasks" asp-action="Index" asp-route-projectId="@project.ProjectId">View Tasks</a>
            </td>
        </tr>
    }
    </tbody>
</table>
